# Database configuration - using SQLite for zero-setup local storage
DATABASE_URL=sqlite:///crisis.db

# Groq API Key (Required for CrewAI multi-agent reasoning: console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Groq Model ID (configurable — change here when models are deprecated)
# Recommended: groq/qwen-qwq-32b (fast), groq/llama-3.1-70b-versatile (capable)
GROQ_MODEL_ID=groq/qwen-qwq-32b

# NewsAPI Key (Optional: newsapi.org)
NEWS_API_KEY=your_newsapi_key_here

# Email Alerts Configuration (Optional: for email_alert.py)
GMAIL_USER=your_email@gmail.com
ALERT_EMAIL=recipient_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password
